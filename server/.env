# Configurazione database MySQL
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_quality_manager

# Chiave per firmare i JWT di sessione (admin e fornitori). Obbligatoria in produzione.
JWT_SECRET=dev-only-secret-change-me-please-1a2b3c4d5e

# Account amministratore creato da "npm run db:init" se non esiste già
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=0404

# Limite massimo (MB) per ogni file caricato (foto, PDF, certificazioni...)
MAX_UPLOAD_MB=50
