# Copy this file to ".env" (same folder, project root) and fill in real values.
# ".env" is already gitignored — never commit real secrets.

# --- Server ---
PORT=5000

# --- Auth ---
# Secret used to sign login tokens. Required in production; a random
# development-only value is used automatically if left unset locally.
JWT_SECRET=

# Seed admin account created on first boot (only if no admin exists yet).
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_quality_manager

# --- Uploads ---
# Max size (MB) accepted by the generic file upload endpoint.
MAX_UPLOAD_MB=50

# --- AI document reading (Technical Area / AP 05.1.1 Product Specification) ---
# Get a key at https://aistudio.google.com/app/apikey (Google AI Studio).
# Required for the "read uploaded document and pre-fill fields" feature on
# the Logistics Sheet / Microbiological Data / Chemical Data / Label uploads.
# Leave empty to disable the feature entirely — every other upload/save flow
# in the app keeps working exactly as before.
GEMINI_API_KEY=

# Optional: override the Gemini model used for document reading.
# GEMINI_MODEL=gemini-3.6-flash

# Optional: max file size (MB) sent to the AI for reading (PDF/JPG/PNG/WEBP only).
# MAX_AI_FILE_MB=15

# --- Email notifications (submission of a qualification) ---
# SMTP credentials of the company mailbox used to send notifications (e.g.
# Office 365 or Google Workspace for italianfoodpivot.it). Ask whoever
# manages that mail domain for an SMTP username/password (or app password).
# Leave empty to disable the feature: the signed-dossier upload still works,
# it just won't send a notification email.
SMTP_HOST=
SMTP_PORT=587
# "true" only if using port 465 (implicit TLS); leave "false" for port 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional: "From" address on the notification email. Defaults to SMTP_USER.
EMAIL_FROM=
# Optional: override the recipient (defaults to qualita@italianfoodpivot.it).
QUALIFICATION_NOTIFY_EMAIL=
# Optional: public URL of this app, used for the link inside the notification email.
# APP_URL=https://qualifica-suppliers.ifptools.com
