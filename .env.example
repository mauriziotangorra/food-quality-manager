# Copy this file to ".env" (same folder, project root) and fill in real values.
# ".env" is already gitignored — never commit real secrets.

# --- Server ---
PORT=5000

# --- Auth ---
# Secret used to sign login tokens. Required in production; a random
# development-only value is used automatically if left unset locally.
JWT_SECRET=

# Seed admin account created on first boot (only if no admin exists yet).
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_quality_manager

# --- Uploads ---
# Max size (MB) accepted by the generic file upload endpoint.
MAX_UPLOAD_MB=50

# --- AI document reading (Technical Area / AP 05.1.1 Product Specification) ---
# Get a key at https://aistudio.google.com/app/apikey (Google AI Studio).
# Required for the "read uploaded document and pre-fill fields" feature on
# the Logistics Sheet / Microbiological Data / Chemical Data / Label uploads.
# Leave empty to disable the feature entirely — every other upload/save flow
# in the app keeps working exactly as before.
GEMINI_API_KEY=

# Optional: override the Gemini model used for document reading.
# GEMINI_MODEL=gemini-3.6-flash

# Optional: max file size (MB) sent to the AI for reading (PDF/JPG/PNG/WEBP only).
# MAX_AI_FILE_MB=15
